# ---------- Servidor ----------
PORT=4000

# Orígenes permitidos por CORS (separados por coma).
# En local React (Vite) corre en el puerto 5173.
# En producción agregue la URL de su frontend, p. ej. https://aprende-jugando.netlify.app
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# ---------- Base de datos MySQL ----------
# Opción A: variables separadas
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=aprende_jugando

# Opción B: una sola URL (tiene prioridad si existe)
# DATABASE_URL=mysql://usuario:clave@host:puerto/aprende_jugando

# Poner en true si el proveedor de MySQL exige SSL (Aiven, TiDB Cloud, etc.)
DB_SSL=false
